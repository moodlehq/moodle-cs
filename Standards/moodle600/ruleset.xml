<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpcodesniffer.com/phpcs.xsd"
    name="moodle600"
    namespace="MoodleHQ\MoodleCS\Moodle600">

    <description>Coding Style Standard for Moodle 6.0</description>

    <!-- Extend the standard Moodle coding style -->
    <rule ref="moodle">
        <exclude name="Generic.Functions.OpeningFunctionBraceKernighanRitchie" />
    </rule>

    <rule ref="moodle.Deprecations.DeprecatedCFGProperties">
        <properties>
            <property name="deprecatedProperties" type="array">
                <element key="httpswwwroot" value="wwwroot" />
                <element key="admin" value="" />
                <element key="loginhttps" value="" />
            </property>
        </properties>
    </rule>

    <!-- MDLSITE-8442 moves to Opening Braces on new lines -->
    <rule ref="PSR2.Classes.ClassDeclaration.OpenBraceNewLine">
        <severity>5</severity>
        <type>warning</type>
    </rule>
    <rule ref="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine">
        <severity>5</severity>
        <type>warning</type>
    </rule>
</ruleset>
